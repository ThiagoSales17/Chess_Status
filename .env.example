# Chess Discord Rich Presence Configuration
# Copy this file to .env and fill in your values

# Required
CHESS_USERNAME=your_chess_username
DISCORD_APP_ID=your_discord_app_id

# Optional
GAME_MODE=rapid          # rapid, blitz, bullet, daily
UPDATE_INTERVAL=15       # seconds between updates
STREAMER_MODE=false      # enable streamer mode
MULTI_ACCOUNT=           # comma-separated additional usernames
